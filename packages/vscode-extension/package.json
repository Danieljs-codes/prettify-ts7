{
  "name": "prettify-ts7",
  "publisher": "danieljs-codes",
  "license": "MIT",
  "private": true,
  "version": "0.1.5",
  "main": "./out/extension.js",
  "scripts": {
    "build": "tsc -p . && pnpm esbuild",
    "esbuild": "esbuild ./src/extension.ts --bundle --minify --sourcemap --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "package": "pnpm esbuild && node ../../scripts/pre-package.js && vsce --version && vsce package --dependencies"
  },
  "dependencies": {
    "@prettify-ts7/typescript-plugin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.44.0",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.25.5",
    "typescript": "^5.4.5",
    "tsgo-api": "npm:typescript@7.0.2"
  },
  "displayName": "Prettify TS 7: Better Type Previews",
  "description": "Prettified, nested types in hover tooltips, for TypeScript 7 (native preview) and TypeScript 6 and earlier. Fork of Prettify TypeScript.",
  "preview": false,
  "icon": "assets/logo.png",
  "engines": {
    "vscode": "^1.44.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Danieljs-codes/prettify-ts7"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "@prettify-ts7/typescript-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "commands": [
      {
        "command": "prettify-ts7.toggle",
        "title": "Toggle Preview",
        "category": "Prettify TS 7"
      },
      {
        "command": "prettify-ts7.copyPrettifiedType",
        "title": "Copy Prettified Type",
        "category": "Prettify TS 7"
      },
      {
        "command": "prettify-ts7.fullCopyPrettifiedType",
        "title": "Copy Fully Prettified Type",
        "category": "Prettify TS 7"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "prettify-ts7.copy",
          "group": "9_cutcopypaste",
          "when": "editorLangId == 'typescript' || editorLangId == 'typescriptreact'"
        }
      ],
      "prettify-ts7.copy": [
        {
          "command": "prettify-ts7.copyPrettifiedType"
        },
        {
          "command": "prettify-ts7.fullCopyPrettifiedType"
        }
      ]
    },
    "submenus": [
      {
        "id": "prettify-ts7.copy",
        "label": "Prettify"
      }
    ],
    "configuration": {
      "title": "Prettify TS 7",
      "properties": {
        "prettify-ts7.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Prettify TS 7."
        },
        "prettify-ts7.typeIndentation": {
          "type": "number",
          "default": 4,
          "minimum": 0
        },
        "prettify-ts7.maxDepth": {
          "type": "number",
          "default": 1,
          "minimum": 0
        },
        "prettify-ts7.maxProperties": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "The maximum number of properties (including sub-properties) to show in a type preview. The number of lines shown will be at most this number."
        },
        "prettify-ts7.maxSubProperties": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "The maximum number of properties to show in a nested (depth greater than 1) type."
        },
        "prettify-ts7.maxUnionMembers": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "The maximum number of members to show in a union."
        },
        "prettify-ts7.maxFunctionSignatures": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "The maximum number of function signatures to show."
        },
        "prettify-ts7.hidePrivateProperties": {
          "type": "boolean",
          "default": true,
          "description": "Hide private properties on an object."
        },
        "prettify-ts7.unwrapFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Prettify function parameters and return types."
        },
        "prettify-ts7.unwrapArrays": {
          "type": "boolean",
          "default": true,
          "description": "Prettify array element types."
        },
        "prettify-ts7.readonlyStyle": {
          "type": "string",
          "enum": [
            "keyword",
            "generic"
          ],
          "enumDescriptions": [
            "readonly T[] and readonly [A, B]",
            "ReadonlyArray<T> and Readonly<[A, B]>"
          ],
          "default": "keyword",
          "description": "How readonly arrays and tuples are written."
        },
        "prettify-ts7.unwrapPromises": {
          "type": "boolean",
          "default": true,
          "description": "Prettify the resolved type of a promise."
        },
        "prettify-ts7.skippedTypeNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Array",
            "ArrayBuffer",
            "Buffer",
            "Date",
            "Element",
            "Error",
            "Map",
            "Number",
            "RegExp",
            "Set",
            "String",
            "Symbol"
          ],
          "description": "Types that won't be unwrapped, by name. Generic types are supported, with their arguments replaced by ellipses (e.g., `ZodObject<...>`)."
        },
        "prettify-ts7.unwrapGenericArgumentsTypeNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Promise",
            "Set",
            "Map",
            "Observable"
          ],
          "description": "A list of generic type names whose arguments will be unwrapped, instead of the apparent (final) type."
        },
        "prettify-ts7.maxCharacters": {
          "type": "number",
          "default": 20000,
          "minimum": 0,
          "maximum": 99000,
          "description": "The maximum number of string characters to show in a type preview before cutting off. (High performance impact)"
        }
      }
    }
  },
  "bugs": {
    "url": "https://github.com/Danieljs-codes/prettify-ts7/issues"
  },
  "homepage": "https://github.com/Danieljs-codes/prettify-ts7#readme",
  "keywords": [
    "typescript",
    "typescript 7",
    "tsgo",
    "types",
    "hover",
    "prettify"
  ]
}
